# Also accepts the original OPEN_ROUTER_API_KEY / TYPE_SAFE_AI_API_KEY names.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
S1S_PROVIDER=openrouter
S1S_MODEL=jev-latest
S1S_TRANSPORT=stdio
S1S_PORT=3100
# Optional file roots for the direct rank CLI helper only.
# Colon-separated on Linux; semicolon-separated on Windows.
# S1S_ROOTS=/absolute/project:/absolute/docs
# S1S_HTTP_TOKEN=at-least-16-characters
