{
  "name": "@levack/s1s-mcp",
  "version": "0.0.1",
  "description": "Local System One search MCP: parallel probabilistic context filtering with Jev",
  "type": "module",
  "bin": {
    "s1s-mcp": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc && node scripts/finalize-build.mjs",
    "build:binary": "node scripts/build-binary.mjs",
    "test:binary": "node scripts/binary-smoke.mjs",
    "test:installer": "node scripts/installer-smoke.mjs",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "tsx scripts/live.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepack": "npm run build",
    "test:package": "node scripts/package-smoke.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "open": "^11.0.4",
    "p-limit": "^7.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "files": [
    "dist/",
    "examples/"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Levack/s1s-mcp.git"
  },
  "homepage": "https://github.com/Levack/s1s-mcp#readme",
  "bugs": {
    "url": "https://github.com/Levack/s1s-mcp/issues"
  },
  "keywords": [
    "mcp",
    "system-one",
    "jev",
    "search",
    "reranking",
    "openrouter"
  ]
}
